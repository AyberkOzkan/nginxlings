# 07 – HTTP Load Balancer (Layer 7)
# Task:
#   - Define "upstream backend" with two servers:
#       127.0.0.1:8081
#       127.0.0.1:8082
#   - Expose a frontend server on port 8080
#   - Proxy "/" to the upstream and log $upstream_addr

events {
    worker_connections 1024;
}

http {
    log_format lb_main
        '$remote_addr - $remote_user [$time_local] '
        '"$request" $status $body_bytes_sent '
        '"$http_referer" "$http_user_agent" '
        'upstream=$upstream_addr';

    # Send access logs to stdout so we can inspect them via "docker logs".
    access_log /dev/stdout lb_main;

    upstream backend {
        # TODO: configure both backend servers here:
        #  - 127.0.0.1:8081
        #  - 127.0.0.1:8082
        #
        # Example:
        #   server 127.0.0.1:8081;
        #   server 127.0.0.1:8082;
    }

    server {
        # Frontend HTTP load balancer endpoint inside the container
        listen      8080;
        server_name localhost;

        # TODO: proxy "/" to the "backend" upstream using HTTP.
        #
        # Example skeleton:
        #
        #   location / {
        #       proxy_pass http://backend;
        #   }
        #
        # You may add extra proxy_set_header directives if you like.
        location / {
            return 200 "TODO: configure proxy_pass to upstream backend\n";
        }
    }
}

